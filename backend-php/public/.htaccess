Options -MultiViews
RewriteEngine On

# Let Apache serve real files/directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Uploaded product images are stored outside DocumentRoot.
RewriteRule ^images/(.+)$ image.php?file=$1 [QSA,L]

# Route every API request through the front controller.
RewriteRule ^ index.php [QSA,L]
